# Copy to .env (chmod 600). .env is gitignored; never commit real values.
# No API keys. The AI steps run through the Codex CLI at build time from committed prompt files; the site never reads .env.
# NCBI E-utilities etiquette: a team contact address (optional; a warning is printed if empty). Optional key raises the rate limit.
NCBI_EMAIL=
NCBI_API_KEY=
